# =============================================================================
# raspi-backup-link — variables de entorno
# Copiar como .env y completar con los valores reales del nodo.
# NUNCA commitear el archivo .env real (contiene el PSK de IPSEC).
# =============================================================================

# -----------------------------------------------------------------------------
# WiFi (enlace de respaldo hacia Internet — "dial up": IP pública dinámica)
# -----------------------------------------------------------------------------
WIFI_SSID=""
WIFI_PASSWORD=""
WIFI_IFACE="wlan0"
WIFI_COUNTRY="CL"

# Host(s) usados para validar que hay salida a Internet por WiFi.
# Separados por espacio. Se prueban en orden hasta obtener respuesta.
INTERNET_CHECK_HOSTS="1.1.1.1 8.8.8.8"
INTERNET_CHECK_TIMEOUT=5

# -----------------------------------------------------------------------------
# Conexión Ethernet (puerto RJ45 integrado del Raspberry Pi 3 B+) al puerto
# OOB / consola del switch — OPCIONAL
# ETH_MODE:
#   none    -> no hay cable conectado al puerto RJ45, se omite esta fase
#   direct  -> conexión punto a punto (patch directo), red /30 o /31
#   switch  -> conexión a través de un switch intermedio, red /29 o menor
#   console -> acceso por puerto de consola (Cisco/Huawei/Juniper) mediante
#              un adaptador USB-serie; la IP propia se asigna a una
#              interfaz loopback /32
# -----------------------------------------------------------------------------
ETH_MODE="none"
ETH_IFACE="eth0"

# Usado cuando ETH_MODE=direct o ETH_MODE=switch
ETH_LOCAL_IP="192.0.2.1"
ETH_CIDR="30"          # 30 o 31 para direct; 29 (o menor) para switch
ETH_PEER_IP="192.0.2.2" # IP del puerto OOB del switch, para validar conectividad

# Usado cuando ETH_MODE=console
LOOPBACK_IFACE="loopback0"
LOOPBACK_IP="192.0.2.9"   # se asigna como /32

# Puerto serie del adaptador USB-consola (solo referencia / uso futuro)
CONSOLE_DEVICE="/dev/ttyUSB0"
CONSOLE_BAUD="9600"

# -----------------------------------------------------------------------------
# Túnel IPSEC hacia el concentrador VPN (IP fija del lado remoto)
# -----------------------------------------------------------------------------
IPSEC_VPN_CONCENTRATOR_IP="203.0.113.1"

# Identidades (FQDN, IP o email) usadas en IKE
IPSEC_LOCAL_ID="node-01.backup.example.com"
IPSEC_REMOTE_ID="vpn-concentrator.example.com"

# Pre-shared key. Alternativamente migrar a certificados en config/ipsec.secrets.template
IPSEC_PSK="CHANGE_ME"

# Selectores de tráfico (fase 2). LOCAL debe coincidir con la red definida
# en ETH_* / LOOPBACK_IP según el caso de uso (fase 2 de las notas del proyecto).
IPSEC_LOCAL_SUBNET="192.0.2.0/30"
IPSEC_REMOTE_SUBNET="10.255.0.0/24"

# Propuestas criptográficas IKE (fase1) y ESP (fase2)
IPSEC_IKE_PROPOSAL="aes256-sha256-modp2048"
IPSEC_ESP_PROPOSAL="aes256-sha256"

IPSEC_DPD_DELAY="30s"
IPSEC_DPD_TIMEOUT="120s"

# -----------------------------------------------------------------------------
# Dispositivo branch de prueba, alcanzable a través del túnel IPSEC
# -----------------------------------------------------------------------------
BRANCH_TEST_IP="10.255.0.1"
BRANCH_CHECK_TIMEOUT=5
