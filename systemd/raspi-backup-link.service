[Unit]
Description=Enlace de respaldo IPSEC sobre WiFi (raspi-backup-link)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/raspi-backup-link
ExecStart=/opt/raspi-backup-link/scripts/run-all.sh
# Reintenta la secuencia periódicamente si algo falla (p. ej. WiFi aún sin señal al bootear)
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
