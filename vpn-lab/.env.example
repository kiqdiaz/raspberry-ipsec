# =============================================================================
# vpn-lab — concentrador VPN emulado (Mac mini) para probar raspi-backup-link
# Copiar como .env y completar. NUNCA commitear el .env real (PSK).
#
# Los valores marcados "== " deben coincidir EXACTAMENTE (mismo PSK, IDs,
# subredes y propuestas criptográficas, con local/remoto invertidos) con el
# .env real que corre en la Raspberry Pi (ver ../.env.example).
# =============================================================================

# -----------------------------------------------------------------------------
# Identidades IKE
# -----------------------------------------------------------------------------
# == IPSEC_REMOTE_ID en la Pi
CONCENTRATOR_ID="vpn-concentrator.example.com"
# == IPSEC_LOCAL_ID en la Pi
NODE_ID="node-01.backup.example.com"

# Pre-shared key — == IPSEC_PSK en la Pi
IPSEC_PSK="CHANGE_ME"

# -----------------------------------------------------------------------------
# Selectores de tráfico (fase 2)
# -----------------------------------------------------------------------------
# Red "detrás" de este concentrador, donde vive el contenedor web aislado.
# == IPSEC_REMOTE_SUBNET en la Pi. También se usa como subnet de la red
# docker "internal_lan" (ver docker-compose.yml).
CONCENTRATOR_SUBNET="10.255.0.0/24"

# Red local del nodo Raspberry Pi (selector que el nodo anuncia como
# "leftsubnet"). == IPSEC_LOCAL_SUBNET en la Pi. Ver notas en README.md
# sobre cómo obtener un selector válido según ETH_MODE.
NODE_SUBNET="192.0.2.0/30"

# -----------------------------------------------------------------------------
# Propuestas criptográficas — == IPSEC_IKE_PROPOSAL / IPSEC_ESP_PROPOSAL en la Pi
# -----------------------------------------------------------------------------
IKE_PROPOSAL="aes256-sha256-modp2048"
ESP_PROPOSAL="aes256-sha256"

IPSEC_DPD_DELAY="30s"
IPSEC_DPD_TIMEOUT="120s"

# -----------------------------------------------------------------------------
# Direcciones dentro de la red interna aislada (CONCENTRATOR_SUBNET)
# -----------------------------------------------------------------------------
# IP del propio contenedor concentrador dentro de internal_lan (actúa como
# gateway/router hacia el contenedor web para el tráfico que llega por el túnel).
CONCENTRATOR_INTERNAL_IP="10.255.0.253"

# IP del contenedor web aislado. Por defecto == BRANCH_TEST_IP en la Pi,
# así scripts/07-check-branch.sh funciona sin tocar el .env de la Pi.
WEB_CONTAINER_IP="10.255.0.1"

# -----------------------------------------------------------------------------
# Solo informativo (no lo usa docker compose): la IP fija de este Mac mini
# en tu LAN, la que pondrás en IPSEC_VPN_CONCENTRATOR_IP del .env de la Pi.
# Asígnala como IP estática o reserva DHCP en tu router — Docker no la gestiona.
# -----------------------------------------------------------------------------
# CONCENTRATOR_PUBLIC_LAN_IP="192.168.1.50"
